# Leave PUBLIC_URL unset for local development — the app uses ATProto's loopback
# client automatically when this is absent.
# For production set this to your public HTTPS origin, e.g.:
# PUBLIC_URL=https://pronouns.blue

# Required in production alongside PUBLIC_URL.
# Generate with: pnpm gen-key
# PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","alg":"ES256"}

# Optional overrides
# PUBLIC_APPVIEW_URL=https://public.api.bsky.app

