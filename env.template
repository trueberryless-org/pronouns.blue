PUBLIC_URL=http://127.0.0.1:3000
# DATABASE_URL is optional — if not set, SQLite is used for local development.
# For production/Vercel, set this to your Postgres (Supabase) connection string:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pronouns_blue

# Optional: Use a private_key_jwt client for production/public deployments.
# Generate with: pnpm gen-key
# PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","alg":"ES256"}

# Optional overrides
# DATABASE_PATH=./app.db   # SQLite file path (local dev only, ignored when DATABASE_URL is set)
# PUBLIC_APPVIEW_URL=https://public.api.bsky.app
