---
import { getCollection, render } from "astro:content";
import PolicyLayout from "../components/policy/PolicyLayout.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const policies = await getCollection("policies");
  return policies.map((policy) => ({
    params: { policy: policy.id.replace(/\.md$/, "") },
    props: { policy },
  }));
}

const { policy } = Astro.props;
const { Content } = await render(policy);
---

<BaseLayout title={`${policy.data.title} – pronouns.blue`} description={policy.data.description}>
  <main class="narrow">
    <PolicyLayout
      title={policy.data.title}
      updated={policy.data.updated}
      description={policy.data.description}
    >
      <Content />
    </PolicyLayout>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 70vh;
    padding-block: 2.5rem 5rem;
  }
</style>
