---
import { getCollection, render } from "astro:content";
import PolicyLayout from "../components/policy/PolicyLayout.astro";
import PrivacyRecords from "../components/policy/PrivacyRecords.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const policies = await getCollection("policies");
  return policies.map((policy) => ({
    params: { policy: policy.id.replace(/\.md$/, "") },
    props: { policy },
  }));
}

const { policy } = Astro.props;
const { Content } = await render(policy);
---

<BaseLayout title={`${policy.data.title} – pronouns.blue`} description={policy.data.description}>
  <main class="narrow">
    <PolicyLayout
      title={policy.data.title}
      updated={policy.data.updated}
      intro={policy.data.intro}
      showLogo={policy.data.showLogo}
      showUpdated={policy.data.showUpdated}
      projectLogo={policy.data.projectLogo}
    >
      <Content />
      {policy.id === "privacy" && <PrivacyRecords />}
    </PolicyLayout>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 70vh;
    padding-block: 2.5rem 5rem;
  }
</style>
