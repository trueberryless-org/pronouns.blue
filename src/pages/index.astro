---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HandleSearch } from "@/components/HandleSearch";
import { HomeUserSection } from "@/components/HomeUserSection";
---

<BaseLayout>
  <main class="flex flex-1 flex-col">
  <div class="mx-auto w-full max-w-6xl px-4 pb-8 sm:px-6">
    <div class="space-y-8">
      <div class="flex justify-center pb-2">
        <img
          src="/pronouns.blue.png"
          alt="pronouns.blue"
          width="966"
          height="396"
          class="h-auto w-auto max-h-60 max-w-full"
          style="view-transition-name: site-logo;"
          fetchpriority="high"
        />
      </div>

      <!-- Personalised welcome / profile cards — rendered client-side -->
      <HomeUserSection client:load />

      <section class="space-y-5 rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center">
        <p class="text-lg text-[var(--muted)]">
          Find any user by handle and view their names and pronouns.
        </p>
        <HandleSearch client:load />
      </section>
    </div>
  </div>
  </main>
</BaseLayout>
