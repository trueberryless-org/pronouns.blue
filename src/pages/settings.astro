---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ProfileEditor } from "@/components/ProfileEditor";
import { getDid } from "@/lib/auth/session";
import { getActorProfile } from "@/lib/atproto/profiles";
import { getProfileRecordsFromPds } from "@/lib/atproto/records";

const did = getDid(Astro.cookies);
if (!did) return Astro.redirect("/");

const [profile, signedInActor] = await Promise.all([
  getProfileRecordsFromPds(did),
  getActorProfile(did),
]);

const normalizedHandle = signedInActor?.handle?.replace(/^@/, "");
const profileHref = normalizedHandle
  ? `/profile/${encodeURIComponent(normalizedHandle)}`
  : null;

const isFirstTime =
  profile.groups.length === 0 ||
  profile.groups.every((g) => g.names.length === 0 && g.pronouns.length === 0);
---

<BaseLayout title="Settings – pronouns.blue">
  <main class="mx-auto w-full max-w-6xl px-4 pb-8 sm:px-6">
    <section class="space-y-4 rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="text-2xl font-semibold text-[var(--text)]">
            {isFirstTime ? "Set up your profile" : "Settings"}
          </h1>
          <p class="text-sm text-[var(--muted)]">
            {isFirstTime ? "Add your names and pronouns to get started." : "Update your names and pronouns."}
          </p>
        </div>
        {profileHref && (
          <a
            href={profileHref}
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-strong)] px-4 py-2 text-sm font-medium text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
            Show profile
          </a>
        )}
      </div>
      <ProfileEditor
        client:load
        initialGroups={profile.groups}
        isFirstTime={isFirstTime}
        profileHref={profileHref ?? undefined}
      />
    </section>
  </main>
</BaseLayout>
