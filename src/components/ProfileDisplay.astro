---
import type { LanguageGroup } from "@/lib/atproto/records";

interface Props {
  title: string;
  handle: string;
  avatar: string | null;
  groups: LanguageGroup[];
  bskyFallbackPronouns?: string | null;
  profileDid?: string;
}

const { title, handle, avatar, groups, bskyFallbackPronouns, profileDid } = Astro.props;

const LANG_NAMES = new Intl.DisplayNames(["en"], { type: "language" });
function langLabel(tag: string): string {
  try { return LANG_NAMES.of(tag) ?? tag; } catch { return tag; }
}

const activeGroups = groups.filter(g => g.names.length > 0 || g.pronouns.length > 0);
const hasAny = activeGroups.length > 0;
const hasBskyPronouns = !hasAny && !!bskyFallbackPronouns;
const showLangLabels = activeGroups.length > 1;
---

<main class="mx-auto w-full max-w-3xl flex-1 min-h-screen px-4 pt-12 pb-16 sm:pt-16">
  <section class="w-full py-4">

    {profileDid && (
      <div class="mb-4 flex justify-end" id="edit-btn-wrap" style="display:none">
        <a href="/settings"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface-strong)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
          aria-label="Edit your names and pronouns" title="Edit profile">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </a>
      </div>
    )}

    <div class="mb-8 flex flex-col items-center text-center">
      {avatar ? (
        <div class="h-24 w-24 rounded-full border border-[var(--border)] bg-cover bg-center"
          style={`background-image: url(${avatar})`} role="img" aria-label={title} />
      ) : (
        <div class="flex h-24 w-24 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--tag-bg)] text-3xl font-semibold text-[var(--text)]">
          {title.slice(0, 1).toUpperCase()}
        </div>
      )}
      <h1 class="mt-4 text-3xl font-bold text-[var(--text)]">{title}</h1>
      <p class="mt-1 flex items-center gap-2 text-base text-[var(--muted)]">
        <span>@{handle}</span>
        <a href={`https://bsky.app/profile/${handle}`} target="_blank" rel="noopener noreferrer"
          aria-label="View on Bluesky" title="View on Bluesky"
          class="text-[var(--muted)] transition-colors hover:text-[var(--accent)]">
          <svg role="img" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/>
          </svg>
        </a>
      </p>
    </div>

    {hasAny ? (
      <div class="space-y-8">
        {activeGroups.map(group => (
          <div class="space-y-4">
            {showLangLabels && (
              <div class="flex items-center gap-2">
                <span class="rounded-full border border-[var(--border)] px-2.5 py-0.5 text-xs font-medium text-[var(--muted)]">
                  {langLabel(group.lang)}
                </span>
                <div class="h-px flex-1 bg-[var(--line)]" />
              </div>
            )}
            <div class={`grid gap-6 ${group.names.length > 0 && group.pronouns.length > 0 ? "md:grid-cols-2" : ""}`}>
              {group.names.length > 0 && (
                <div>
                  <div class="mb-3 flex items-center gap-2">
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--muted)]">Names</h2>
                  </div>
                  <ul>
                    {group.names.map(name => (
                      <li class="flex items-center justify-between border-b border-[var(--line)] py-2 text-base text-[var(--text)]">
                        <span>{name}</span>
                        {group.preferredNames.includes(name) && (
                          <span title="Preferred">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 text-[var(--danger)]" fill="currentColor" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 20.5C11.7 20.5 11.4 20.4 11.2 20.2L4.2 13.8C2.2 12 2 8.9 3.8 6.9C5.6 4.9 8.7 4.7 10.7 6.5L12 7.7L13.3 6.5C15.3 4.7 18.4 4.9 20.2 6.9C22 8.9 21.8 12 19.8 13.8L12.8 20.2C12.6 20.4 12.3 20.5 12 20.5Z"/>
                            </svg>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {group.pronouns.length > 0 && (
                <div>
                  <div class="mb-3 flex items-center gap-2">
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--muted)]">Pronouns</h2>
                  </div>
                  <ul>
                    {group.pronouns.map(pronoun => (
                      <li class="flex items-center justify-between border-b border-[var(--line)] py-2 text-base text-[var(--text)]">
                        <span>{pronoun}</span>
                        {group.preferredPronouns.includes(pronoun) && (
                          <span title="Preferred">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 text-[var(--danger)]" fill="currentColor" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 20.5C11.7 20.5 11.4 20.4 11.2 20.2L4.2 13.8C2.2 12 2 8.9 3.8 6.9C5.6 4.9 8.7 4.7 10.7 6.5L12 7.7L13.3 6.5C15.3 4.7 18.4 4.9 20.2 6.9C22 8.9 21.8 12 19.8 13.8L12.8 20.2C12.6 20.4 12.3 20.5 12 20.5Z"/>
                            </svg>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : hasBskyPronouns ? (
      <div class="grid gap-6">
        <div>
          <div class="mb-3 flex items-center gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--muted)]">Pronouns</h2>
            <span class="flex items-center gap-1 rounded-full border border-[var(--border)] px-1.5 py-0.5 text-[10px] text-[var(--muted)]">
              <svg role="img" viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="currentColor" aria-hidden="true"><path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/></svg>
              from Bluesky
            </span>
          </div>
          <ul>
            <li class="flex items-center justify-between border-b border-[var(--line)] py-2 text-base text-[var(--text)]">
              <span>{bskyFallbackPronouns}</span>
            </li>
          </ul>
        </div>
      </div>
    ) : (
      <p class="text-center text-[var(--muted)]">This user hasn&apos;t set any names or pronouns yet.</p>
    )}
  </section>
</main>

{profileDid && (
  <script define:vars={{ profileDid }}>
    const m = document.cookie.match(/(?:^|;\s*)did-public=([^;]+)/);
    const userDid = m ? decodeURIComponent(m[1]) : null;
    if (userDid && userDid.toLowerCase() === profileDid.toLowerCase()) {
      const wrap = document.getElementById("edit-btn-wrap");
      if (wrap) wrap.style.display = "";
    }
  </script>
)}
