---
import type { ActorProfile } from "../../lib/atproto/profile";

interface Props {
  actor: ActorProfile;
}

const { actor } = Astro.props;
const title = actor.displayName ?? actor.handle;
---

<header class="profile-header">
  {
    actor.avatar ? (
      <img src={actor.avatar} alt="" width="96" height="96" />
    ) : (
      <span class="avatar-fallback">{title.charAt(0).toUpperCase()}</span>
    )
  }
  <h1>{title}</h1>
  <p>
    @{actor.handle}
    <a href={`https://bsky.app/profile/${actor.handle}`} target="_blank" rel="noreferrer">
      View on Bluesky
    </a>
  </p>
</header>

<style>
  .profile-header {
    display: grid;
    justify-items: center;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  img,
  .avatar-fallback {
    width: 6rem;
    height: 6rem;
    border: 1px solid var(--border);
    border-radius: 50%;
  }

  img {
    object-fit: cover;
  }

  .avatar-fallback {
    display: grid;
    place-items: center;
    background: var(--tag-bg);
    font-size: 2rem;
    font-weight: 700;
  }

  h1 {
    margin: 1rem 0 0;
    font-size: 2rem;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.2rem 0 0;
    color: var(--muted);
  }

  a {
    color: var(--accent);
    font-size: 0.75rem;
  }
</style>
