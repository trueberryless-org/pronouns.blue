---
import type { ActorProfile } from "../../lib/atproto/profile";

interface Props {
  actor: ActorProfile;
}

const { actor } = Astro.props;
const title = actor.displayName ?? actor.handle;
---

<header class="profile-header">
  {
    actor.avatar ? (
      <img src={actor.avatar} alt="" width="96" height="96" />
    ) : (
      <span class="avatar-fallback">{title.charAt(0).toUpperCase()}</span>
    )
  }
  <h1>{title}</h1>
  <p>
    <span>@{actor.handle}</span>
    <a href={`https://bsky.app/profile/${actor.handle}`} target="_blank" rel="noreferrer">
      <span class="sr-only">View on Bluesky</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026" />
      </svg>
    </a>
  </p>
</header>

<style>
  .profile-header {
    display: grid;
    justify-items: center;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  img,
  .avatar-fallback {
    width: 6rem;
    height: 6rem;
    border: 1px solid var(--border);
    border-radius: 50%;
  }

  img {
    object-fit: cover;
  }

  .avatar-fallback {
    display: grid;
    place-items: center;
    background: var(--tag-bg);
    font-size: 2rem;
    font-weight: 700;
  }

  h1 {
    margin: 1rem 0 0;
    font-size: 2rem;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.2rem 0 0;
    color: var(--muted);
  }

  a {
    color: var(--accent);
    line-height: 0;
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }
</style>
