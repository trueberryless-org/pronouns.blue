---
import type { FollowProfile } from "../../lib/atproto/profile";

interface Props {
  follows: FollowProfile[];
  cursor?: string;
  did: string;
}

const { follows, cursor, did } = Astro.props;
---

<section class="more" data-follows data-did={did} data-cursor={cursor}>
  <h2>More to explore</h2>
  <p>People this user follows on Bluesky</p>
  <div class="grid" data-follows-grid>
    {
      follows.map((actor) => (
        <a class="follow card" href={`/profile/${encodeURIComponent(actor.handle)}`}>
          {actor.avatar ? (
            <img src={actor.avatar} alt="" width="48" height="48" loading="lazy" />
          ) : (
            <span>{(actor.displayName ?? actor.handle).charAt(0).toUpperCase()}</span>
          )}
          <strong>{actor.displayName ?? actor.handle}</strong>
          <small>@{actor.handle}</small>
        </a>
      ))
    }
  </div>
  {cursor && <button class="button" type="button" data-load-follows>Load more</button>}
</section>

<script>
  import { initializeFollows } from "../../scripts/follows";
  document.addEventListener("astro:page-load", initializeFollows);
</script>

<style>
  .more {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding-top: 2.5rem;
  }

  h2,
  p {
    margin: 0;
  }

  p {
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem;
  }

  .follow {
    display: grid;
    min-width: 0;
    justify-items: center;
    padding: 1rem;
    text-align: center;
    text-decoration: none;
  }

  .follow:hover {
    border-color: var(--accent);
  }

  img,
  .follow span {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
  }

  img {
    object-fit: cover;
  }

  .follow span {
    display: grid;
    place-items: center;
    background: var(--tag-bg);
    font-weight: 700;
  }

  strong,
  small {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  strong {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  small {
    color: var(--muted);
  }

  button {
    margin: 1.5rem auto 0;
  }
</style>
