---
import type { LanguageGroup } from "../../lib/atproto/records";
import IdentityList from "./IdentityList.astro";

interface Props {
  groups: LanguageGroup[];
  fallbackPronouns: string | null;
}

const { fallbackPronouns } = Astro.props;
const groups = Astro.props.groups.filter(
  (group) => group.names.length > 0 || group.pronouns.length > 0,
);
const languageNames = new Intl.DisplayNames(["en"], { type: "language" });
const label = (tag: string) => {
  try {
    return languageNames.of(tag) ?? tag;
  } catch {
    return tag;
  }
};
---

{
  groups.length > 0 ? (
    <div class="groups">
      {groups.map((group) => (
        <section class="group">
          {groups.length > 1 && (
            <div class="language">
              <span>{label(group.lang)}</span>
              <i />
            </div>
          )}
          <div class="columns">
            {group.names.length > 0 && (
              <IdentityList
                title="Names"
                values={group.names}
                preferred={group.preferredNames}
              />
            )}
            {group.pronouns.length > 0 && (
              <IdentityList
                title="Pronouns"
                values={group.pronouns}
                preferred={group.preferredPronouns}
              />
            )}
          </div>
        </section>
      ))}
    </div>
  ) : fallbackPronouns ? (
    <div class="fallback">
      <div class="fallback-heading">
        <span>Pronouns</span>
        <small>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026" />
          </svg>
          from Bluesky
        </small>
      </div>
      <IdentityList title="" values={[fallbackPronouns]} preferred={[]} />
    </div>
  ) : (
    <p class="empty">This user hasn’t set any names or pronouns yet.</p>
  )
}

<style>
  .groups,
  .group {
    display: grid;
    gap: 2rem;
  }

  .language {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .language span {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .language i {
    height: 1px;
    flex: 1;
    background: var(--line);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 2rem;
  }

  .empty {
    color: var(--muted);
    text-align: center;
  }

  .fallback-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: -0.25rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fallback-heading small {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }

  .fallback-heading svg {
    width: 0.625rem;
    fill: currentColor;
  }
</style>
