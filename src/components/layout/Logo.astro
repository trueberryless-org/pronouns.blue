---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a href="/" class:list={["logo", { compact }]} aria-label="pronouns.blue home">
  <img
    src="/pronouns.blue.png"
    alt="pronouns.blue"
    width="966"
    height="396"
    loading="eager"
    transition:name="site-logo"
  />
</a>

<style>
  .logo {
    display: block;
    width: min(100%, 30rem);
  }

  .compact {
    width: 8.5rem;
  }

  img {
    width: 100%;
    height: auto;
  }
</style>
