---
interface Props {
  compact?: boolean;
  linked?: boolean;
}

const { compact = false, linked = true } = Astro.props;
---

{
  linked ? (
    <a href="/" class:list={["logo", { compact }]} aria-label="pronouns.blue home">
      <img
        src="/pronouns.blue.png"
        alt="pronouns.blue"
        width="966"
        height="396"
        loading="eager"
        style="view-transition-name: site-logo"
      />
    </a>
  ) : (
    <img
      class="hero-logo"
      src="/pronouns.blue.png"
      alt="pronouns.blue"
      width="966"
      height="396"
      loading="eager"
      style="view-transition-name: site-logo"
    />
  )
}

<style>
  .logo {
    display: block;
    width: min(100%, 30rem);
  }

  .compact {
    width: 8.5rem;
  }

  .logo img {
    width: 100%;
    height: auto;
  }

  .hero-logo {
    width: auto;
    max-width: 100%;
    max-height: 15rem;
    height: auto;
  }
</style>
