---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideNavLogo?: boolean;
}

const {
  title = "pronouns.blue",
  description = "Share your names and pronouns with the AT Protocol.",
  image = "/pronouns.blue.png",
  hideNavLogo = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/pronouns.blue-round.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        if (location.hostname === "localhost") {
          const url = new URL(location.href);
          url.hostname = "127.0.0.1";
          location.replace(url);
          return;
        }
        const readTheme = () => {
          try {
            return localStorage.getItem("pronounsblue-theme") || "dark";
          } catch {
            return "dark";
          }
        };
        document.documentElement.dataset.theme = readTheme();
        if (!document.documentElement.dataset.themeListener) {
          document.documentElement.dataset.themeListener = "true";
          document.addEventListener("astro:before-swap", (event) => {
            event.newDocument.documentElement.dataset.theme = readTheme();
          });
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="page">
    <Header hideLogo={hideNavLogo} />
    <slot />
    <Footer />
  </body>
</html>
