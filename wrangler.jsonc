{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pronouns-blue",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "PUBLIC_URL": "https://pronouns.blue",
  },
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
}
