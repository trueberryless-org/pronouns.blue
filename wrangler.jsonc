{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-01",
  "name": "pronouns-blue",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
