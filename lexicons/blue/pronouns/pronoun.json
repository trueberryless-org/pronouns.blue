{
  "id": "blue.pronouns.pronoun",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": ["value", "preferred", "createdAt", "updatedAt"],
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "maxGraphemes": 64
          },
          "preferred": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
