{
  "name": "pronouns.blue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:lex": "ts-lex build --importExt=\"\" --out=./lib/lexicons --override",
    "build:cloudflare": "pnpm build:lex && opennextjs-cloudflare build",
    "build": "pnpm build:lex && next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start --port ${PORT-3000}",
    "gen-key": "tsx scripts/gen-key.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@atproto/common-web": "^0.4.11",
    "@atproto/lex": "^0.0.10",
    "@atproto/oauth-client-node": "^0.3.15",
    "@atproto/syntax": "^0.4.2",
    "next": "16.2.6",
    "next-view-transitions": "^0.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81"
}
